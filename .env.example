# Copy to .env and fill in real values: `cp .env.example .env`

# ---------------------------------------------------------------------------
# Locker
# ---------------------------------------------------------------------------

# The real provider API key Locker uses server-side to reach the LLM
# provider (OpenAI by default). Locker validates this at startup and
# refuses to start if it's missing — see
# ../locker/internal/config/config.go.
OPENAI_API_KEY=

# Sent by LibreChat to Locker as a client Authorization header
# (librechat.yaml's custom endpoint `apiKey`). Locker does not currently
# validate incoming client credentials — there is no client-auth layer
# yet (see ../locker/Docs/roadmap.md) — so any non-empty placeholder
# works here; LibreChat's config just requires the field to be non-empty.
LOCKER_API_KEY=unused-locker-does-not-check-this

# ---------------------------------------------------------------------------
# LibreChat
# ---------------------------------------------------------------------------

HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Meilisearch/RAG are intentionally not part of this bundle — see
# Docs/versions.md. Disables LibreChat's dependency on a search service
# that isn't running.
SEARCH=false

# Generate fresh values for every deployment — do NOT reuse LibreChat's
# own publicly-documented example values (they're example values,
# committed to their public repo, so treating them as secret defeats the
# purpose). Required sizes: CREDS_KEY is a 32-byte key (64 hex chars),
# CREDS_IV is a 16-byte IV (32 hex chars); JWT_*_SECRET can be any random
# hex string.
#   openssl rand -hex 32   # -> CREDS_KEY, JWT_SECRET, JWT_REFRESH_SECRET
#   openssl rand -hex 16   # -> CREDS_IV
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
